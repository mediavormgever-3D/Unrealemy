{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unrealemy.local/curriculum.schema.json",
  "title": "Unrealemy leerlijnen",
  "description": "Schema voor curriculum.json, track.json, hoofdstukken en UI-profielen. Gebruik: python Tools/validate_curriculum.py",
  "$defs": {
    "curriculum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "tracks"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "tracks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "number",
        "title",
        "summary",
        "chapters"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^t[0-9]+$"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "summary": {
          "type": "string",
          "maxLength": 200
        },
        "chapters": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^c[0-9]{2}-[a-z0-9-]+\\.json$"
          }
        }
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "number",
        "title",
        "summary",
        "starter_map",
        "steps"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^t[0-9]+\\.c[0-9]{2}$"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "summary": {
          "type": "string",
          "maxLength": 200
        },
        "starter_map": {
          "description": "Map die als sjabloon wordt geopend; het origineel wordt nooit gewijzigd.",
          "type": "string",
          "pattern": "^/[A-Za-z0-9_/]+$"
        },
        "setup": {
          "$ref": "#/$defs/callable"
        },
        "ui_profile": {
          "$ref": "#/$defs/profile_id"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "instruction",
        "validate",
        "solve"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^t[0-9]+\\.c[0-9]{2}\\.s[0-9]{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "instruction": {
          "description": "Eén handeling. Kort gehouden zodat een stap echt een micro-stap blijft.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "hints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "ui_profile": {
          "$ref": "#/$defs/profile_id"
        },
        "highlight": {
          "$ref": "#/$defs/highlight"
        },
        "validate": {
          "$ref": "#/$defs/check"
        },
        "solve": {
          "$ref": "#/$defs/callable"
        }
      }
    },
    "callable": {
      "description": "Module in unrealemy/chapters plus functienaam, bv. t1_c01.solve_s05",
      "type": "string",
      "pattern": "^[a-z0-9_]+\\.[a-z_][a-z0-9_]*$"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+(\\.[a-z0-9_-]+)*$"
    },
    "highlight": {
      "description": "Precies één doel: een tab-ID, of een widget-tag (te vinden met de Widget Reflector).",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "tab": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "mesh": {
          "$ref": "#/$defs/asset_path"
        }
      }
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "positive": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "asset_path": {
      "type": "string",
      "pattern": "^/[A-Za-z0-9_/]+(\\.[A-Za-z0-9_]+)?$"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "check": {
      "type": "object",
      "anyOf": [
        {
          "required": [
            "all"
          ]
        },
        {
          "required": [
            "any"
          ]
        },
        {
          "required": [
            "type"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "all"
            ]
          },
          "then": {
            "additionalProperties": false,
            "properties": {
              "all": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/check"
                }
              },
              "message": {
                "$ref": "#/$defs/message"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "any"
            ]
          },
          "then": {
            "additionalProperties": false,
            "properties": {
              "any": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/check"
                }
              },
              "message": {
                "$ref": "#/$defs/message"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "enum": [
                  "actor_exists",
                  "transform_near",
                  "actor_moved",
                  "selection_is",
                  "property_compare",
                  "viewport_camera_moved",
                  "viewport_camera_rotated",
                  "viewport_looks_at",
                  "material_input_from",
                  "blueprint_exec_linked",
                  "actor_in_folder",
                  "attached_to",
                  "component_exists"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "actor_exists"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "actor"
            ],
            "properties": {
              "type": true,
              "message": {
                "$ref": "#/$defs/message"
              },
              "actor": {
                "$ref": "#/$defs/selector"
              },
              "min_count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "transform_near"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "actor"
            ],
            "anyOf": [
              {
                "required": [
                  "location"
                ]
              },
              {
                "required": [
                  "rotation"
                ]
              },
              {
                "required": [
                  "scale"
                ]
              }
            ],
            "properties": {
              "type": true,
              "message": {
                "$ref": "#/$defs/message"
              },
              "actor": {
                "$ref": "#/$defs/selector"
              },
              "location": {
                "$ref": "#/$defs/vec3"
              },
              "rotation": {
                "description": "[X/roll, Y/pitch, Z/yaw] zoals in het Details-paneel",
                "$ref": "#/$defs/vec3"
              },
              "scale": {
                "$ref": "#/$defs/vec3"
              },
              "tolerance": {
                "$ref": "#/$defs/positive"
              },
              "rotation_tolerance": {
                "$ref": "#/$defs/positive"
              },
              "scale_tolerance": {
                "$ref": "#/$defs/positive"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "actor_moved"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "actor",
              "min_distance"
            ],
            "properties": {
              "type": true,
              "message": {
                "$ref": "#/$defs/message"
              },
              "actor": {
                "$ref": "#/$defs/selector"
              },
              "min_distance": {
                "$ref": "#/$defs/positive"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "selection_is"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "actor"
            ],
            "properties": {
              "type": true,
              "message": {
                "$ref": "#/$defs/message"
              },
              "actor": {
                "$ref": "#/$defs/selector"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "property_compare"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "actor",
              "property",
              "op",
              "value"
            ],
            "properties": {
              "type": true,
              "message": {
                "$ref": "#/$defs/message"
              },
              "actor": {
                "$ref": "#/$defs/selector"
              },
              "component": {
                "description": "Klasse van de component waarop property gelezen wordt, bv. PointLightComponent",
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*Component$"
              },
              "property": {
                "description": "Python-namen met punten, bv. point_light_component.attenuation_radius",
                "type": "string",
                "pattern": "^[a-z_][a-z0-9_]*(\\.[a-z_][a-z0-9_]*)*$"
              },
              "op": {
                "enum": [
                  "==",
                  "!=",
                  "<",
                  "<=",
                  ">",
                  ">="
                ]
              },
              "value": {
                "type": [
                  "number",
                  "string",
                  "boolean"
                ]
              },
              "tolerance": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "viewport_camera_moved"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "min_distance"
            ],
            "properties": {
              "type": true,
              "message": {
                "$ref": "#/$defs/message"
              },
              "min_distance": {
                "$ref": "#/$defs/positive"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "viewport_camera_rotated"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "min_degrees"
            ],
            "properties": {
              "type": true,
              "message": {
                "$ref": "#/$defs/message"
              },
              "min_degrees": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 180
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "viewport_looks_at"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "actor"
            ],
            "properties": {
              "type": true,
              "message": {
                "$ref": "#/$defs/message"
              },
              "actor": {
                "$ref": "#/$defs/selector"
              },
              "max_angle": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 90
              },
              "max_distance": {
                "$ref": "#/$defs/positive"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "material_input_from"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "material",
              "input",
              "expression_class"
            ],
            "properties": {
              "type": true,
              "message": {
                "$ref": "#/$defs/message"
              },
              "material": {
                "$ref": "#/$defs/asset_path"
              },
              "input": {
                "enum": [
                  "base_color",
                  "metallic",
                  "specular",
                  "roughness",
                  "emissive_color",
                  "opacity",
                  "opacity_mask",
                  "normal",
                  "ambient_occlusion"
                ]
              },
              "expression_class": {
                "type": "string",
                "pattern": "^MaterialExpression[A-Za-z0-9]+$"
              },
              "parameter_name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "blueprint_exec_linked"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "blueprint",
              "event",
              "function"
            ],
            "properties": {
              "type": true,
              "message": {
                "$ref": "#/$defs/message"
              },
              "blueprint": {
                "$ref": "#/$defs/asset_path"
              },
              "event": {
                "description": "Interne naam, bv. ReceiveBeginPlay voor Event BeginPlay",
                "type": "string",
                "minLength": 1
              },
              "function": {
                "description": "Interne naam, bv. PrintString",
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "actor_in_folder"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "actor",
              "folder"
            ],
            "properties": {
              "type": true,
              "message": {
                "$ref": "#/$defs/message"
              },
              "actor": {
                "$ref": "#/$defs/selector"
              },
              "folder": {
                "description": "Map in de Outliner; submappen met /, bv. Lantaarn/Onderdelen",
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "attached_to"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "actor",
              "parent"
            ],
            "properties": {
              "type": true,
              "message": {
                "$ref": "#/$defs/message"
              },
              "actor": {
                "$ref": "#/$defs/selector"
              },
              "parent": {
                "$ref": "#/$defs/selector"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "component_exists"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "actor",
              "class"
            ],
            "properties": {
              "type": true,
              "message": {
                "$ref": "#/$defs/message"
              },
              "actor": {
                "$ref": "#/$defs/selector"
              },
              "class": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*Component$"
              },
              "min_count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "ui_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "hide_tabs",
        "show_tabs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/profile_id"
        },
        "description": {
          "type": "string"
        },
        "hide_tabs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "show_tabs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
